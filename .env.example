# Supabase (use your own project from https://supabase.com/dashboard)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_public_key

# MCP server (Claude Desktop / Cowork / Cursor) — see mcp-server/START_HERE.md
# Run: node scripts/setup-claude-mcp.mjs
# REMOASSET_API_URL=https://YOUR_PROJECT_REF.supabase.co/functions/v1/api
# REMOASSET_API_KEY=ra_your_api_key_from_admin_panel

# Required only for: create-admin script and Edge Functions (server-side only)
# Get from: Dashboard → Project Settings → API → service_role (secret). Never use in frontend.
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_secret
